NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_clerk_production_publishable_key
CLERK_SECRET_KEY=sk_live_replace_with_clerk_production_secret_key

# Production PostgreSQL connection strings
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Paystack South Africa / ZAR keys
# Use sk_test_/pk_test_ while testing, then replace with live keys before launch.
PAYSTACK_SECRET_KEY=sk_live_replace_with_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_replace_with_paystack_public_key

# Canonical public URL & brand configuration
NEXT_PUBLIC_APP_URL=https://shopdivinitycosmetics.co.za
NEXT_PUBLIC_SUPPORT_EMAIL=support@shopdivinitycosmetics.co.za
NEXT_PUBLIC_WHATSAPP_NUMBER=27820000000

# Configure this URL in the Paystack dashboard:
