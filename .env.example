NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_clerk_production_publishable_key
CLERK_SECRET_KEY=sk_live_replace_with_clerk_production_secret_key

# Production PostgreSQL connection strings
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Paystack South Africa / ZAR keys
# Use sk_test_/pk_test_ while testing, then replace with live keys before launch.
PAYSTACK_SECRET_KEY=sk_live_replace_with_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_replace_with_paystack_public_key

# Canonical public URL & brand configuration
NEXT_PUBLIC_APP_URL=https://shopdivinitycosmetics.co.za
NEXT_PUBLIC_SUPPORT_EMAIL=support@shopdivinitycosmetics.co.za
NEXT_PUBLIC_WHATSAPP_NUMBER=+27 66 485 9011

# Zoho One Suite API Credentials (Server-based Application for Books & Inventory)
# Obtain from Zoho Developer Console: https://api-console.zoho.com
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_ORG_ID=your_zoho_organization_id_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Configure this URL in the Paystack dashboard:
# https://shopdivinitycosmetics.co.za/api/paystack-webhook (or /api/webhooks/paystack)

# The Courier Guy / Shiplogic API Credentials
# Resolution order: COURIER_GUY_API_KEY (live) -> COURIER_GUY_API_TEST_KEY (sandbox) -> SHIPLOGIC_API_KEY
# Keep the live key commented out until launch day. Sandbox host: https://api.shiplogic.com
# Production host: https://api.portal.thecourierguy.co.za  (no /v2 suffix; code appends /v3/...)
# COURIER_GUY_API_KEY=your_live_courier_guy_api_key_here
COURIER_GUY_API_TEST_KEY=your_shiplogic_sandbox_api_key_here
COURIER_GUY_API_URL=https://api.shiplogic.com
COURIER_GUY_SERVICE_LEVEL=ECO

# Dispatch Hub (Default: Wright Crossing Shopping Centre, Springs, Gauteng)
DISPATCH_HUB_NAME="Divinity Cosmetics Dispatch Hub"
DISPATCH_HUB_STREET="Wright Crossing Shopping Centre, 70 Ermelo Rd"
DISPATCH_HUB_SUBURB="Strubenvale"
DISPATCH_HUB_CITY="Springs"
DISPATCH_HUB_PROVINCE="Gauteng"
DISPATCH_HUB_POSTAL_CODE="1559"
DISPATCH_HUB_PHONE="+27 66 485 9011"
DISPATCH_HUB_EMAIL="fulfillment@shopdivinitycosmetics.co.za"

# Zoho Inventory Dispatch Webhook Secret (REQUIRED - requests without it get 401)
# Configure in Zoho Inventory Workflow Rule Webhook:
# Target: https://shopdivinitycosmetics.co.za/api/webhooks/zoho/dispatch
# Custom header: x-zoho-webhook-secret: <same value as below>
ZOHO_WEBHOOK_SECRET=your_zoho_webhook_secret_here
